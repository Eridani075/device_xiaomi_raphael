+void DRMConnectorManager::GetConnectorList(std::vector<uint32_t> *conn_ids) {
+  lock_guard<mutex> lock(lock_);
+  if (!conn_ids) {
+    DRM_LOGE("No output parameter provided.");
+    return;
+  }
+  conn_ids->clear();
+  for (auto &conn : connector_pool_) {
+    conn_ids->push_back(conn.first);
+  }
