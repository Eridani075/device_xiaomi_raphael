+  if (name == "dspp_caps") { return DRMProperty::DSPP_CAPABILITIES; }
+  if (name == "SDE_DSPP_RC_MASK_V1") { return DRMProperty::DSPP_RC_MASK_V1; }
+
+  return DRMProperty::INVALID;
+}
+
+}  // namespace sde_drm
