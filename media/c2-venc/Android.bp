// Codec2 video encoder (AVC, HEVC) for sm8150, built on the QTI V4L2 engine.
//
// The service stages NV12 in the Codec2 component and uses the
// sm8250 venc_dev engine for V4L2. VENC_HOST_C2 selects its Codec2 host.

cc_library_static {
    name: "libc2venc_engine",
    vendor: true,
    compile_multilib: "64",

    srcs: [
        "engine/src/video_encoder_device_v4l2.cpp",
        // The sm8250 engine splits its V4L2 parameter handling into a second
        // file, and vidc_common.cpp provides do_sync_ioctl().
        "engine/src/video_encoder_device_v4l2_params.cpp",
        "engine/src/vidc_common.cpp",
    ],

    cflags: [
        "-Werror",
        "-Wno-unused-parameter",
        "-D_ANDROID_",
        "-D_ANDROID_ICS_",
        "-D_UBWC_",
        "-DUSE_CAMERA_METABUFFER_UTILS",
        "-DUSE_ION",
        "-DUSE_NATIVE_HANDLE_SOURCE",
        // Selects C2VencHost over omx_venc as venc_dev's host class.
        "-DVENC_HOST_C2",
    ],

    local_include_dirs: ["engine/inc"],

    include_dirs: [
        "system/memory/libion/include",
        "system/memory/libion/kernel-headers",
        // The engine comes from the sm8250 media tree, whose V4L2 control
        // vocabulary matches this kernel. Its header
        // libs have the same names as the sm8150 ones. Use the sm8250
        // include paths directly and keep its audio modules out of Make.
        "hardware/qcom-caf/sm8250/media/mm-video-v4l2/vidc/common/inc",
        "hardware/qcom-caf/sm8250/media/mm-core/inc",
        "hardware/qcom-caf/sm8250/media/libc2dcolorconvert",
    ],

    header_libs: [
        "//hardware/qcom-caf/sm8150:display_headers",
        "//hardware/qcom-caf/sm8150:libc2dcolorconvert_headers",
        "//hardware/qcom-caf/sm8150:libomxcore_headers",
        "//hardware/qcom-caf/sm8150:libplatformconfig_headers",
        "//hardware/qcom-caf/sm8150:libstagefrighthw_headers",
        "media_plugin_headers",
        "qti_kernel_headers",
        "libc2venc_headers",
    ],

    shared_libs: [
        "libcutils",
        "libion",
        "liblog",
        "//hardware/qcom-caf/sm8150:libplatformconfig",
        "//vendor/qcom/opensource/display:libqdMetaData",
    ],
}

cc_library_headers {
    name: "libc2venc_headers",
    export_include_dirs: ["inc"],
    vendor: true,
}

// The Codec2 component itself. Kept separate from the engine library so a
// build failure in the C2 translation layer cannot be confused with one in the
// reused V4L2 code.
cc_library_shared {
    name: "libc2venc",
    vendor: true,
    compile_multilib: "64",

    srcs: [
        "src/C2VencHost.cpp",
        "src/C2VencComponent.cpp",
    ],

    cflags: [
        "-Werror",
        "-Wno-unused-parameter",
        "-D_ANDROID_",
        "-D_ANDROID_ICS_",
        "-D_UBWC_",
        "-DUSE_ION",
        "-DVENC_HOST_C2",
    ],

    local_include_dirs: ["engine/inc"],

    include_dirs: [
        "system/memory/libion/include",
        "system/memory/libion/kernel-headers",
        // Use the same sm8250 V4L2 headers as libc2venc_engine.
        "hardware/qcom-caf/sm8250/media/mm-video-v4l2/vidc/common/inc",
        "hardware/qcom-caf/sm8250/media/mm-core/inc",
        "hardware/qcom-caf/sm8250/media/libc2dcolorconvert",
    ],

    header_libs: [
        "//hardware/qcom-caf/sm8150:display_headers",
        "//hardware/qcom-caf/sm8150:libc2dcolorconvert_headers",
        "libcodec2_headers",
        "libcodec2_soft_common_headers",
        "libcodec2_vndk_headers",
        "//hardware/qcom-caf/sm8150:libomxcore_headers",
        "//hardware/qcom-caf/sm8150:libplatformconfig_headers",
        "//hardware/qcom-caf/sm8150:libstagefrighthw_headers",
        "media_plugin_headers",
        "qti_kernel_headers",
        "libc2venc_headers",
    ],

    shared_libs: [
        "libcodec2",
        "libcodec2_soft_common",
        "libcodec2_vndk",
        "libcutils",
        "libsfplugin_ccodec_utils",
        // V4L2 engine dependencies. The engine compiles its own vidc_common
        // and the Codec2 host supplies is_ubwc_interlaced.
        "//hardware/qcom-caf/sm8150:libplatformconfig",
        "//vendor/qcom/opensource/display:libqdMetaData",
        "libion",
        "liblog",
        "libutils",
    ],

    static_libs: [
        "libc2venc_engine",
        // RGBA -> NV12 on the CPU, as AOSP's software encoders do it.
        "libyuv",
    ],
}

// The vendor HIDL store exposes both encoders on the transport used by Raphael.
cc_binary {
    name: "sm8150-c2-venc-service",
    vendor: true,
    compile_multilib: "64",
    relative_install_path: "hw",

    defaults: [
        "libcodec2-hidl-defaults",
    ],

    srcs: [
        "src/C2VencStore.cpp",
        "src/service.cpp",
    ],

    cflags: [
        "-Wall",
        "-Werror",
    ],

    shared_libs: [
        "libavservices_minijail",
        "libbinder",
        "libc2venc",
        "libstagefright_foundation",
    ],

    required: [
        "android.hardware.media.c2-default-seccomp_policy",
        "sm8150-c2-venc-extended-seccomp_policy",
    ],

    init_rc: ["sm8150-c2-venc.rc"],
    vintf_fragments: ["c2_manifest_sm8150_venc.xml"],
}

// Extend the default policy for the V4L2 engine and vendor buffer allocation.
prebuilt_etc {
    name: "sm8150-c2-venc-extended-seccomp_policy",
    vendor: true,
    sub_dir: "seccomp_policy",
    src: "seccomp_policy/android.hardware.media.c2-extended-seccomp_policy",
}
